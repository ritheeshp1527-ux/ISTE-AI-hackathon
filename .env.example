# ==========================================
# Dev 1: Document Ingestion, Indexing & Retrieval
# Configuration Template
# DO NOT COMMIT REAL SECRETS OR KEYS
# ==========================================

# Chroma Vector Database Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=documents

# Ingestion Settings
DOCUMENTS_DIRECTORY=./data/documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Provider Configuration (Placeholders only)
# EMBEDDING_PROVIDER can be 'chroma_default', 'openai', 'gemini', or 'huggingface'
EMBEDDING_PROVIDER=chroma_default
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# API Keys (Provide real values only in your local uncommitted .env file)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Retrieval Settings
DEFAULT_TOP_K=5
